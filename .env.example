POSTGRES_DB=barbers
POSTGRES_USER=barbers
POSTGRES_PASSWORD=change-me

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=barbers.navonsimon.com,localhost,127.0.0.1

# Optional bootstrap admin. LEAVE THE PASSWORD EMPTY unless you are setting a
# real one — the entrypoint skips creation when it is blank, so a placeholder
# here would otherwise become a live superuser login.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# Permanent owner logins: "+9725xxxxxxxx:code,+9725yyyyyyyy:code" (never commit)
MASTER_OTP_PAIRS=

REDIS_URL=redis://valkey:6379/0

# Grist CRM (optional) — every landing-page signup is upserted into the shop
# owner's Grist doc. Leave empty to disable. In prod Grist runs in
# /srv/barbers-crm on the shared "barbers-crm" docker network.
GRIST_URL=http://grist:8484
GRIST_API_KEY=
GRIST_DOC_ID=
PUBLIC_BASE_URL=https://barbers.navonsimon.com

# WhatsApp "new lead" alert via the self-hosted whatsmeow bridge (debian02).
# Recipients: comma-separated E.164 without "+". Leave empty to disable.
WHATSAPP_BRIDGE_URL=http://10.0.0.20:8080
LEAD_ALERT_WHATSAPP_TO=
CRM_URL=https://barbers-crm.navonsimon.com
